# 讯飞星火 API
SPARK_APP_ID=your_app_id
SPARK_API_KEY=your_api_key
SPARK_API_SECRET=your_api_secret

# 数据库
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/a3_learning

# 向量库
VECTOR_DB_PATH=./chroma_db

# JWT 密钥
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 可选：DeepSeek API（补充）
DEEPSEEK_API_KEY=

# 多模型自动降级（密钥只写入本地 .env，禁止提交）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ANT_BAILING_API_KEY=
ANT_BAILING_BASE_URL=https://api.ant-ling.com/v1
ANT_BAILING_MODEL=Ling-2.6-flash
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# 日志级别
LOG_LEVEL=INFO
